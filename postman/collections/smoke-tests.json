{
  "info": {
    "name": "Peer-to-Peer Payments API - Smoke Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Smoke gate generated from the APIM-exported spec. Collection-level script checks every endpoint is up: success status, fast, non-empty body."
  },
  "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{bearerToken}}", "type": "string" } ] },
  "variable": [ { "key": "baseUrl", "value": "https://api.acmefinance.example.com/p2p/v1" } ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Smoke: success status (200/201)', function(){ pm.expect([200,201]).to.include(pm.response.code); });",
          "pm.test('Smoke: responds under 3000ms', function(){ pm.expect(pm.response.responseTime).to.be.below(3000); });",
          "pm.test('Smoke: body not empty', function(){ pm.expect(pm.response.text().length).to.be.above(0); });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "payments",
      "item": [
        {
          "name": "List payments",
          "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{baseUrl}}/payments?limit=25", "host": [ "{{baseUrl}}" ], "path": [ "payments" ], "query": [ { "key": "limit", "value": "25" } ] } }
        },
        {
          "name": "Create a payment",
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }, { "key": "x-mock-response-code", "value": "201" } ], "body": { "mode": "raw", "raw": "{\"amount\":100.5,\"currency\":\"USD\",\"fromAccount\":\"acct_1\",\"toAccount\":\"acct_2\",\"memo\":\"poc\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/payments", "host": [ "{{baseUrl}}" ], "path": [ "payments" ] } }
        },
        {
          "name": "Get a payment by id",
          "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{baseUrl}}/payments/:paymentId", "host": [ "{{baseUrl}}" ], "path": [ "payments", ":paymentId" ], "variable": [ { "key": "paymentId", "value": "string" } ] } }
        }
      ]
    },
    {
      "name": "accounts",
      "item": [
        {
          "name": "Get account balance",
          "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{baseUrl}}/accounts/:accountId/balance", "host": [ "{{baseUrl}}" ], "path": [ "accounts", ":accountId", "balance" ], "variable": [ { "key": "accountId", "value": "string" } ] } }
        }
      ]
    }
  ]
}
